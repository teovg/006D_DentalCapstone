# Deja URL y clave vacias para usar el repositorio local de demostracion.
EXPO_PUBLIC_SUPABASE_URL=
# Clave publica recomendada. Nunca uses una secret key o service_role en Expo.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad temporal con proyectos que aun usan la anon key legada.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
