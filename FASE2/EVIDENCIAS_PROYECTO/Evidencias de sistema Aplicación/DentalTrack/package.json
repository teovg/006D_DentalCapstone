    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.25",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "panelui-native": "1.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.5",
    "uniwind": "^1.13.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tesseract.js-data/spa": "1.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "tesseract.js": "7.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "design:mobile": "node scripts/design-preview.mjs --mobile",
    "design:mobile:export": "node scripts/design-preview.mjs --mobile --export",
    "ocr": "node services/ocr/server.mjs",
    "demo:semana14": "node services/ocr/demo.mjs",
    "demo:clase": "node services/ocr/class-demo.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:demo": "node services/android/demo.mjs",
    "android:demo:serve": "node services/android/demo.mjs --serve",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "postinstall": "node scripts/prepare-panelui.mjs",
    "pretypecheck": "node scripts/check-source-integrity.mjs",
    "test:database": "node scripts/test-database.mjs",
    "education": "node services/education/server.mjs"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-sqlite"
        ]
      }
    }
  }
